OPENAI_API_KEY=CHANGE_ME
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# 可选：全局温度。若公司 Azure/OpenAI-compatible 部署不支持 temperature，请保持为空。
OPENAI_TEMPERATURE=
# IntentParser 温度；不支持 temperature 的部署请保持为空
OPENAI_INTENT_TEMPERATURE=
# Finalize 温度；不支持 temperature 的部署请保持为空
OPENAI_FINALIZE_TEMPERATURE=
# 公司内部根证书（可选，等价 curl --cacert）
OFFICETOOL_CA_CERT_PATH=

# Docker build（公司内网常用）
# 1) 把根证书放到仓库 certs/ 目录（不会被 git 提交）
# 2) COMPANY_CA_CERT_FILENAME 写证书文件名，如 CompanyInternalRootCA.cer
COMPANY_CA_CERT_FILENAME=
# 3) 若公司要求内网 PyPI，请配置以下项
PIP_INDEX_URL=
PIP_EXTRA_INDEX_URL=
# 可填单个或多个（逗号分隔），例如：pypi.org,files.pythonhosted.org,pypi.python.org
PIP_TRUSTED_HOST=

# Zeus: 用 sku + matrix_id + test_id 拼链接（如不需要sku，可移除{sku}）
ZEUS_TEST_URL_TEMPLATE=https://zeus.example.com/{sku}/test/{matrix_id}/{test_id}
ZEUS_SKU_DEFAULT=nx1
ZEUS_LOG_ZIP_NAME=logsarchive.zip

# 直接从浏览器复制 Cookie header 全串到这里（最方便）
ZEUS_COOKIE=

# 如果还要补 header（JSON）
ZEUS_EXTRA_HEADERS_JSON=

# Dify
DIFY_BASE_URL=https://dify.example.com
DIFY_MODE=chat
DIFY_SPEC_APP_KEY=
DIFY_TP_APP_KEY=
DIFY_JIRA_APP_KEY=

CACHE_TTL_SECONDS=600

# Frontend mode:
# - api: Streamlit -> FastAPI
# - local: Streamlit 直接调用 jupiter_core（调试更快）
JUPITER_UI_MODE=api
# 可填多个，逗号分隔。示例：Docker 用 http://backend:8000，本地用 http://127.0.0.1:8000
JUPITER_BACKEND=http://127.0.0.1:8000
