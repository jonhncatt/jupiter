FROM python:3.11-slim
ARG COMPANY_CA_CERT_FILENAME=""
ARG PIP_INDEX_URL=""
ARG PIP_EXTRA_INDEX_URL=""
ARG PIP_TRUSTED_HOST=""
WORKDIR /app

COPY certs /tmp/certs
RUN if [ -n "$COMPANY_CA_CERT_FILENAME" ] && [ -f "/tmp/certs/$COMPANY_CA_CERT_FILENAME" ]; then \
      cp "/tmp/certs/$COMPANY_CA_CERT_FILENAME" /usr/local/share/ca-certificates/company-root-ca.crt; \
      if command -v update-ca-certificates >/dev/null 2>&1; then update-ca-certificates; fi; \
    fi

RUN if [ -n "$PIP_INDEX_URL" ]; then pip config set global.index-url "$PIP_INDEX_URL"; fi \
    && if [ -n "$PIP_EXTRA_INDEX_URL" ]; then pip config set global.extra-index-url "$PIP_EXTRA_INDEX_URL"; fi \
    && if [ -n "$PIP_TRUSTED_HOST" ]; then pip config set global.trusted-host "$PIP_TRUSTED_HOST"; fi

COPY pyproject.toml /app/pyproject.toml
RUN if [ -n "$COMPANY_CA_CERT_FILENAME" ] && [ -f "/tmp/certs/$COMPANY_CA_CERT_FILENAME" ]; then \
      export PIP_CERT="/tmp/certs/$COMPANY_CA_CERT_FILENAME"; \
      export SSL_CERT_FILE="/tmp/certs/$COMPANY_CA_CERT_FILENAME"; \
      export REQUESTS_CA_BUNDLE="/tmp/certs/$COMPANY_CA_CERT_FILENAME"; \
    fi; \
    pip install --no-cache-dir -U pip && pip install --no-cache-dir -e .
COPY apps /app/apps
EXPOSE 8000
CMD ["uvicorn", "apps.backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
